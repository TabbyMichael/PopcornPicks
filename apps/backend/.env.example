# PopcornPicks backend environment
# Copy to .env and fill in real values (never commit .env).
PORT=4000
TMDB_API_KEY=your_tmdb_api_key_here
# Postgres (docker compose up -d). Requires DATABASE_URL for auth/watchlist modules.
DATABASE_URL=postgres://popcornpicks:popcornpicks@localhost:5433/popcornpicks
# Secret used to sign JWTs (auth module). Generate: openssl rand -hex 32
JWT_SECRET=change_me
# Optional overrides (defaults shown)
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# Comma-separated CORS whitelist (default: frontend dev server)
# ALLOWED_ORIGINS=http://localhost:8080
